# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key_here"

# Paystack Configuration
# Get these values from: https://dashboard.paystack.com/#/settings/developer
# Test keys for development, Live keys for production

VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key_here"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key_here"

# Payment Configuration
VITE_DELIVERY_FEE="1000"
VITE_RIDER_SHARE="500"
VITE_PLATFORM_SHARE="500"
VITE_MIN_WITHDRAWAL_VENDOR="1000"
VITE_MIN_WITHDRAWAL_RIDER="500"

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual credentials
# 3. For Paystack: Use test keys for development, live keys for production
# 4. Never commit the .env file to version control
# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

VITE_SUPABASE_PROJECT_ID="your_project_id_here"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key_here"

# KoraPay Configuration
# Get these values from: https://korapay.com/dashboard/settings/api-keys
VITE_KORAPAY_PUBLIC_KEY="your_korapay_public_key_here"
KORAPAY_SECRET_KEY="your_korapay_secret_key_here"
KORAPAY_WEBHOOK_SECRET="your_korapay_webhook_secret_here"

# Payment Configuration
VITE_PAYMENT_CURRENCY="NGN"
VITE_PAYMENT_ENVIRONMENT="test" # test or live
VITE_ESCROW_RELEASE_DELAY_HOURS="24" # Hours to hold funds in escrow

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual credentials
# 3. Never commit the .env file to version control
# 4. For KoraPay: Sign up at https://korapay.com and get your API keys